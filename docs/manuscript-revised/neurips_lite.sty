% Lightweight NeurIPS-style layout (single column, 10pt Times).
% Self-contained approximation of the official neurips_2024.sty for
% compilation with tectonic; not the official file.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_lite}[2026/09/22 v1.0 Lightweight NeurIPS-like style]

\RequirePackage{mathptmx}      % Times text + math
\RequirePackage[T1]{fontenc}
\RequirePackage{geometry}
\geometry{
  letterpaper,
  textwidth=5.5in,
  textheight=9in,
  top=1in,
  bottom=1in,
  left=1in,
  right=1in
}
\RequirePackage{natbib}
\setcitestyle{authoryear,round,comma,aysep={,}}

% Headings ---------------------------------------------------------------
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{14pt plus 2pt minus 2pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt plus 2pt minus 2pt}{4pt}

% Title block ------------------------------------------------------------
\newcommand{\@noticetext}{}
\renewcommand{\maketitle}{%
  \par
  \begingroup
    \renewcommand{\thefootnote}{}\fnsymbol{footnote}
    \centering
    {\LARGE\bfseries \@title \par}
    \vspace{1.2em}
    {\normalsize \@author \par}
    \vspace{0.6em}
    \ifx\@empty\@noticetext\else
      {\footnotesize \@noticetext \par}
    \fi
    \vspace{0.8em}
  \endgroup
}

% Abstract environment ----------------------------------------------------
\renewenvironment{abstract}{%
  \vspace{0.5em}
  \noindent\begin{center}\large\bfseries Abstract\end{center}
  \begingroup\small\noindent\ignorespaces
}{%
  \par\endgroup\vspace{0.5em}
}

% Caption setup -----------------------------------------------------------
\RequirePackage[font=small,labelfont=bf]{caption}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}
\setlength{\headheight}{12pt}
